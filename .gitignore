# Dados processados e modelos (gerados por script, não versionados)
data/processed/*
models/*
!data/processed/.gitkeep
!models/.gitkeep

# Dados brutos: os CSVs de origem SÃO versionados para
# garantir reprodutibilidade (arquivos públicos e leves)
# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/
*.egg-info/

# ── Jupyter ─────────────────────────────────────────────────
.ipynb_checkpoints/

# ── VS Code ─────────────────────────────────────────────────
.vscode/

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db